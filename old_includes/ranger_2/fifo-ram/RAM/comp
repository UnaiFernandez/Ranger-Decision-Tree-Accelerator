#!/bin/bash
if [ -z "$1" ]
  then
    sim_time="250ns"
else
    sim_time=$1
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

name="ram"
name_pkg=${name}_pkg
name_tb=${name}_tb

echo -n "COMPILING ..."
echo ""


if ! ghdl -a ../utils_pkg.vhd src/${name_pkg}.vhd src/${name}.vhd test/${name_tb}.vhd; then
    echo -en "${RED} FAILED :( ${NC}"
    echo ""
else
    echo -en "${GREEN} SUCCESS :) ${NC}"
    echo ""

    echo -n "SIMULATING ..."
    echo ""
    ghdl -e $name_tb


    if ! ghdl -r $name_tb --wave=test/sim_${name}.ghw --stop-time=${sim_time}; then
        echo -en "${RED} FAILED :( ${NC}"
        echo ""
    else
        echo -en "${GREEN} SUCCESS :) ${NC}"
        echo ""
    fi
fi

